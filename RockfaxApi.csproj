<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Description>Unofficial C# client for the Rockfax / UKClimbing app API (reverse engineered from the Rockfax Android app).</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The demo and desktop projects live in subfolders; keep them out of the library compile. -->
    <Compile Remove="RockfaxApi.Demo/**" />
    <Compile Remove="RockfaxDesk/**" />
    <None Remove="RockfaxApi.Demo/**" />
    <None Remove="RockfaxDesk/**" />
  </ItemGroup>

</Project>
