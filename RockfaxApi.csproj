<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Unofficial C# client for the Rockfax / UKClimbing app API (reverse engineered from the Rockfax Android app).</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The demo, desktop and test projects live in subfolders; keep them out of the library compile. -->
    <Compile Remove="RockfaxApi.Demo/**" />
    <Compile Remove="RockfaxDesk/**" />
    <Compile Remove="RockfaxApi.Tests/**" />
    <None Remove="RockfaxApi.Demo/**" />
    <None Remove="RockfaxDesk/**" />
    <None Remove="RockfaxApi.Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RockfaxApi.Tests" />
  </ItemGroup>

</Project>
